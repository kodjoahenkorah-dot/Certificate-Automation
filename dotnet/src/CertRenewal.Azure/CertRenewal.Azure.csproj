<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CertRenewal.Azure</RootNamespace>
    <Description>Azure Key Vault and App Service renewal providers, plus an environment-variable credential resolver for local testing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CertRenewal.Core/CertRenewal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
    <PackageReference Include="Azure.Security.KeyVault.Certificates" Version="4.7.0" />
    <PackageReference Include="Azure.ResourceManager.AppService" Version="1.2.0" />
  </ItemGroup>

</Project>
