<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CertRenewal.Acme</RootNamespace>
    <Description>ACME (Let's Encrypt / ZeroSSL) renewal provider with pluggable challenge solver and certificate installer ports, plus an Azure DNS DNS-01 solver.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CertRenewal.Core/CertRenewal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Certes" Version="3.0.4" />
    <PackageReference Include="Azure.ResourceManager.Dns" Version="1.1.1" />
  </ItemGroup>

</Project>
